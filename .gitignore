node_modules/
dist/
.DS_Store
*.log

# Variables d'environnement / secrets — JAMAIS commités.
.env
.env.*
!.env.example
!.env.production.example
# Exception : build Pages branché sur Supabase — valeurs PUBLIQUES uniquement
# (clé anon + URL ; arbitrées par la RLS). Voir .env.production.example.
!.env.production

# Supabase (CLI)
supabase/.temp/
supabase/.branches/

# Playwright artifacts
playwright-report/
test-results/

# Rapports de couverture (npm run test:coverage)
coverage/

# Copies complètes du dépôt, créées par les agents lancés en `isolation:
# worktree`. Elles étaient masquées par `.git/info/exclude`, qui est LOCAL :
# invisible à `git status` ici, absent partout ailleurs. Versionnée, la ligne
# couvre aussi Prettier, qui honore `.gitignore` depuis la 3.x.
.claude/worktrees/
