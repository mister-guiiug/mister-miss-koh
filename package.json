{
  "name": "mister-miss-koh",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "description": "Mister & miss Koh — PWA de suivi des saisons d'aventure : candidats, épisodes, épreuves, conseils, votes et départs, avec notes privées, favoris et partage révocable. Faits tracés depuis l'API Wikipédia, jamais présentés comme officiels. Non officiel.",
  "scripts": {
    "build": "tsc -b && vite build && pwa-bundle-budget",
    "build:analyze": "cross-env ANALYZE=1 npm run build",
    "captures": "node scripts/captures.mjs",
    "dev": "vite",
    "doctor": "pwa-doctor",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "pwa-icons --source public/favicon.svg --out public --maskable",
    "lint": "eslint .",
    "prepare": "husky || true",
    "preview": "vite preview --base /mister-miss-koh/",
    "supabase:link": "supabase link",
    "supabase:push": "supabase db push",
    "supabase:types": "supabase gen types typescript --linked > src/backend/database.types.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:edge": "cd supabase/functions && deno test --allow-read _shared/",
    "test:publication:remote": "node scripts/pgtap-remote.mjs publication.test.sql",
    "test:rls:remote": "node scripts/pgtap-remote.mjs rls.test.sql",
    "test:watch": "vitest",
    "type-check": "tsc -b"
  },
  "bundleBudget": {
    "totalGzipKb": 280
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@mister-guiiug/dev-pwa-config": "^4.4.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.34.5",
    "typescript": "~6.0.3",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@rive-app/react-canvas": "^4.28.4",
    "@supabase/supabase-js": "^2.106.2",
    "lucide-react": "^1.17.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.1",
    "tailwindcss": "^4.2.2",
    "zod": "^4.0.0",
    "zustand": "^5.0.12"
  },
  "engines": {
    "node": ">=22"
  }
}
